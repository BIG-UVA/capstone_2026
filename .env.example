# Copy this file to .env and fill in your own local Postgres password.
# .env is gitignored and should never be committed or shared —
# this .env.example is the template that's safe to share instead.

DATABASE_URL=postgresql://postgres:YOUR_PASSWORD_HERE@localhost:5432/capstone_db
API_BASE_URL=http://localhost:8000
PG_PASSWORD=YOUR_PASSWORD_HERE
